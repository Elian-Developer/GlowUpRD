@GloupUpRD.API_HostAddress = http://localhost:5297
@Token = REEMPLAZAR_CON_TOKEN

POST {{GloupUpRD.API_HostAddress}}/api/autenticacion/registrar
Content-Type: application/json

{
  "nombre": "Usuario",
  "apellido": "Prueba",
  "correo": "usuario@ejemplo.com",
  "password": "ClaveSegura123"
}

