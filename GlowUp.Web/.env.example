# Use "local" for a frontend-only demo or "api" for the .NET backend.
VITE_AUTH_MODE=local

# Leave empty in development so the browser uses Vite's /api proxy.
VITE_API_URL=

# IIS Express HTTPS endpoint used internally by Vite during development.
VITE_API_PROXY_TARGET=https://localhost:44352

# OAuth 2.0 Client ID from Google Cloud Console (APIs & Services > Credentials).
# Leave empty to keep the Google sign-in button disabled.
VITE_GOOGLE_CLIENT_ID=
